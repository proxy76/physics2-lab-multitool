{
  "name": "lab-companion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare-py": "node scripts/fetch-py.mjs",
    "dev": "node scripts/fetch-py.mjs && vite",
    "build": "node scripts/fetch-py.mjs && tsc -p . --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -p . --noEmit",
    "test:pyodide": "node scripts/fetch-py.mjs && node tests/pyodide-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "katex": "^0.19.0",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "pyodide": "^314.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
